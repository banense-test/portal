{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Portal": "Host=__DB_HOST__;Port=5432;Database=__DB_NAME__;Username=__DB_USER__;Password=__DB_PASSWORD__"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "https://__OIDC_ISSUER__/realms/__OIDC_REALM__",
      "ClientId": "__OIDC_CLIENT_ID__",
      "ClientSecret": "__OIDC_CLIENT_SECRET__"
    }
  },
  "Directory": {
    "Ldap": {
      "Host": "__LDAP_HOST__",
      "BindAccount": "__LDAP_BIND_ACCOUNT__",
      "BindPassword": "__LDAP_BIND_PASSWORD__",
      "BaseDn": "__LDAP_BASE_DN__"
    }
  }
}
