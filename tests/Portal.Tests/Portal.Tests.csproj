<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Portal.Tests</RootNamespace>
    <AssemblyName>Portal.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    One compatible set: the xunit v2 runner (2.8.x) pairs with xunit 2.9.x.
    xunit.runner.visualstudio 3.x is the xunit v3 runner and does not pair with
    xunit 2.x — mixing them fails at test discovery.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Portal.Web\Portal.Web.csproj" />
  </ItemGroup>

</Project>
